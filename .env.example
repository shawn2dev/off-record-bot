XP_DISCORD_TOKEN=replace-me
XP_APPLICATION_ID=replace-me
XP_GUILD_ID=replace-me
XP_DATABASE_PATH=/var/lib/off-record-xp/xp.sqlite
XP_EXCLUDED_CHANNEL_IDS=
# Freeze nickname changes and restorations without stopping other features.
XP_NICKNAME_PAUSED=false

# Keep disabled until the fixed HTTPS origin, Discord callback and Tunnel exist.
XP_API_ENABLED=false
XP_API_HOST=127.0.0.1
XP_API_PORT=8080
XP_API_ORIGIN=
XP_DASHBOARD_URL=https://main--off-record-bot-site--shawn2dev.aem.live/dashboard
XP_API_ALLOWED_SITE_ORIGINS=https://main--off-record-bot-site--shawn2dev.aem.live
# Defaults to XP_APPLICATION_ID when empty.
XP_OAUTH_CLIENT_ID=
XP_OAUTH_CLIENT_SECRET=
XP_API_TRUST_TUNNEL=false
XP_API_ALLOW_HTTP_LOCAL=false
XP_ACCESS_TTL_SECONDS=300
XP_SESSION_TTL_HOURS=168