[Unit]
Description=Back up the Off Record XP SQLite database

[Service]
Type=oneshot
User=off-record-xp
Group=off-record-xp
ExecStart=/usr/local/lib/off-record-xp/backup-xp.sh
StateDirectory=off-record-xp
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=