[Unit]
Description=Off Record Discord XP Gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=off-record-xp
Group=off-record-xp
WorkingDirectory=/opt/off-record-xp
EnvironmentFile=/etc/off-record-xp.env
Environment=NODE_OPTIONS=--max-old-space-size=192
ExecStart=/usr/local/bin/node /opt/off-record-xp/src/xp-bot.js
Restart=always
RestartSec=10
TimeoutStopSec=45
StateDirectory=off-record-xp
StateDirectoryMode=0700
UMask=0077
MemoryMax=320M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20

[Install]
WantedBy=multi-user.target